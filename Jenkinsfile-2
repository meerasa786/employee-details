
pipeline {
    agent any

    stages {

        stage('Checkout Code') {
            steps {
                git 'https://github.com/meerasa786/employee-details.git'
            }
        }

        stage('Compile') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Package') {
            steps {
                sh 'mvn package'
            }
        }

        stage('Deploy to Tomcat') {
            steps {
                sh '''
                curl -v -u tomcat:password \
                -T target/*.war \
                "http://3.237.45.221:8080/manager/text/deploy?path=/employee&update=true"
                '''
            }
        }
    }
}
